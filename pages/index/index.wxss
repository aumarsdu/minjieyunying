/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 0;
}

.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  color: #fff;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #fff;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-top: 20rpx;
}

.content {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.feature-list {
  margin-top: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  font-size: 28rpx;
  color: #666;
}

.feature-icon {
  color: #1aad19;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 15rpx;
}

.feature-text {
  flex: 1;
}

.user-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-name {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.btn {
  width: 100%;
  margin: 0;
  padding: 25rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-secondary {
  background: linear-gradient(135deg, #1aad19 0%, #0d8d13 100%);
  color: #fff;
}

.btn-warning {
  background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
  color: #fff;
}

.footer {
  padding: 40rpx 20rpx 60rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}
