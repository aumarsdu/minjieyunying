<!--pages/logs/logs.wxml-->
<view class="container">
  <view class="page-header">
    <text class="page-title">日志记录</text>
    <text class="page-desc">查看应用访问日志</text>
  </view>

  <view class="logs-content">
    <view class="log-item" wx:for="{{logs}}" wx:key="index">
      <view class="log-header">
        <text class="log-index">{{index + 1}}</text>
        <text class="log-time">{{item}}</text>
      </view>
      <view class="log-divider"></view>
    </view>

    <view class="empty-state" wx:if="{{logs.length === 0}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无日志记录</text>
    </view>
  </view>

  <view class="action-bar">
    <button class="btn btn-primary" bindtap="addLog">添加日志</button>
    <button class="btn btn-danger" bindtap="clearLogs">清空日志</button>
  </view>
</view>
